<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.OnTime" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#0D0D11</item>
        <item name="android:navigationBarColor">#0D0D11</item>
        <item name="android:windowBackground">#0D0D11</item>
    </style>

    <style name="Theme.OnTime.AlarmScreen" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:showWhenLocked">true</item>
        <item name="android:turnScreenOn">true</item>
    </style>
</resources>

